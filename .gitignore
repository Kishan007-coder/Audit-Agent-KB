import csv
import json
import os
import tempfile
import unittest
from pathlib import Path

from audit_agent.engine import AuditEngine


class AuditEngineTests(unittest.TestCase):
    def test_audit_csv_generates_control_results(self):
        with tempfile.TemporaryDirectory() as tmpdir:
            csv_path = Path(tmpdir) / "tickets.csv"
            rows = [
                {
                    "Ticket Number": "SR-1001",
                    "Assignment Group": "Operations",
                    "Assigned To": "John",
                    "Opened Date/Time": "2024-01-01 09:00",
                    "Closed Date/Time": "2024-01-02 10:00",
                    "Description": "Request to reset Active Directory password.",
                    "Approval": "Customer approval required and approved on 2024-01-01 08:30.",
                    "Work Notes": "Customer approval was received before the activity. Implementation window: from 2024-01-01 10:00 to 2024-01-01 12:00.",
                    "Doer": "John",
                    "Checker": "Jane",
                    "Pre-Doer": "Verified user identity.",
                    "Pre-Checker": "Validated account details.",
                    "Post-Doer": "Password reset performed.",
                    "Post-Checker": "User confirmed login.",
                    "Closure Notes": "Request completed; user confirmed successful login.",
                    "Status Check": "Status check: user is waiting on verification.",
                },
                {
                    "Ticket Number": "SR-1001",
                    "Assignment Group": "Operations",
                    "Assigned To": "John",
                    "Opened Date/Time": "2024-01-01 09:00",
                    "Closed Date/Time": "2024-01-02 10:00",
                    "Description": "Request to reset Active Directory password.",
                    "Approval": "Customer approval required and approved on 2024-01-01 08:30.",
                    "Work Notes": "Customer approval was received before the activity. Implementation window: from 2024-01-01 10:00 to 2024-01-01 12:00.",
                    "Doer": "John",
                    "Checker": "Jane",
                    "Pre-Doer": "Verified user identity.",
                    "Pre-Checker": "Validated account details.",
                    "Post-Doer": "Password reset performed.",
                    "Post-Checker": "User confirmed login.",
                    "Closure Notes": "Request completed; user confirmed successful login.",
                    "Status Check": "Status check: user is waiting on verification.",
                },
            ]

            with csv_path.open("w", newline="", encoding="utf-8") as fh:
                writer = csv.DictWriter(fh, fieldnames=list(rows[0].keys()))
                writer.writeheader()
                writer.writerows(rows)

            report = AuditEngine().audit_csv(csv_path)
            self.assertEqual(report["validated_unique_ticket_count"], 1)
            self.assertEqual(report["duplicate_rows_removed"], 1)
            self.assertEqual(report["tickets"][0]["controls"][0]["result"], "YES")

    def test_missing_ticket_id_is_assigned(self):
        with tempfile.TemporaryDirectory() as tmpdir:
            csv_path = Path(tmpdir) / "tickets.csv"
            rows = [{
                "Assignment Group": "Operations",
                "Description": "Missing ticket id row",
                "Work Notes": "Approval not required.",
            }]
            with csv_path.open("w", newline="", encoding="utf-8") as fh:
                writer = csv.DictWriter(fh, fieldnames=list(rows[0].keys()))
                writer.writeheader()
                writer.writerows(rows)

            report = AuditEngine().audit_csv(csv_path)
            self.assertEqual(report["validated_unique_ticket_count"], 1)
            self.assertTrue(report["tickets"][0]["ticket_id"].startswith("MISSING-TICKET-ID-"))


if __name__ == "__main__":
    unittest.main()
